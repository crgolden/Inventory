{
  "name": "inventory.client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node start-os.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "lint:css": "npm ci --prefix tools/stylelint --ignore-scripts && node tools/stylelint/node_modules/stylelint/bin/stylelint.mjs \"src/**/*.css\"",
    "lint:utilities": "check-design-utilities",
    "test": "ng test",
    "bddgen": "bddgen",
    "e2e": "bddgen && playwright test",
    "e2e:ui": "bddgen && playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:ci": "bddgen && playwright test --project=chromium --max-failures=1",
    "e2e:synthetic": "playwright test --project=synthetic",
    "typecheck:e2e": "bddgen && tsc -p tsconfig.e2e.json",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit",
    "playwright:install": "playwright install --with-deps chromium",
    "prestart": "node aspnetcore-https",
    "start:windows": "ng serve --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\" --host=127.0.0.1",
    "start:default": "ng serve --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\" --host=127.0.0.1",
    "audit": "check-npm-audit"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@ng-icons/core": "^36.0.0",
    "@ng-icons/lucide": "^36.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "marked": "^18.1.0",
    "odata-query": "^8.1.0",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/schematics": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@crgolden/modules": "0.18.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-istanbul": "^5.0.2",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "76.0.0",
    "jsdom": "^30.1.2",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.2",
    "zone.js": "^0.16.3"
  },
  "overrides": {
    "undici": "^7.24.4"
  }
}
